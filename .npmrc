# electron-builder cannot package pnpm's default symlinked node_modules layout.
#
# By default pnpm symlinks workspace dependencies: apps/desktop/node_modules/@skiff/core
# is a link whose real target is packages/core, which sits outside apps/desktop.
# electron-builder resolves that symlink to its real path and refuses it —
#
#   packages/core/LICENSE must be under apps/desktop/
#
# That check runs on the resolved real path, before the `files` glob patterns
# are applied, which is why excluding LICENSE/README by pattern does not help.
# packages/core's own "files": ["dist"] doesn't help either — that only governs
# what npm publish includes, not what electron-builder walks on disk.
#
# node-linker=hoisted makes pnpm build a real npm-style node_modules tree
# (actual directories, no symlinks), which electron-builder can package
# normally. Costs some disk space and loses pnpm's strictness about phantom
# dependencies; both are acceptable next to not being able to ship at all.
node-linker=hoisted
