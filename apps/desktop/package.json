{
  "name": "@skiff/desktop",
  "//productName": "Top level on purpose. Electron's app.getName() reads the top-level productName and falls back to `name` — it does not look inside the electron-builder `build` block. Without this the app called itself @skiff/desktop, so app.getPath('userData') resolved to %APPDATA%\\@skiff/desktop: a path containing a forward slash. Chromium could not create its cache there, which fails file:// loads with a bare ERR_FAILED and left the window blank on every packaged install.",
  "productName": "Skiff",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "description": "Skiff desktop application — native SSH connection manager and access governance.",
  "homepage": "https://skiffssh.me",
  "author": "Skiff Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Priyanshu-1622/skiff-app.git"
  },
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -n vite,electron -c cyan,magenta \"pnpm dev:renderer\" \"pnpm dev:main\"",
    "dev:renderer": "pnpm --filter @skiff/web dev",
    "dev:main": "pnpm build:main && electron .",
    "build:main": "tsc -p tsconfig.main.json && node scripts/build-preload.mjs",
    "build:renderer": "pnpm --filter @skiff/web build --base=./ --outDir=../desktop/dist/renderer --emptyOutDir && node scripts/finalize-renderer.mjs",
    "build": "pnpm build:main && pnpm build:renderer",
    "typecheck": "tsc --noEmit -p tsconfig.main.json",
    "package": "pnpm build && electron-builder",
    "package:win": "pnpm build && electron-builder --win",
    "package:mac": "pnpm build && electron-builder --mac",
    "package:linux": "pnpm build && electron-builder --linux",
    "postinstall": "pnpm exec electron-builder install-app-deps",
    "test": "node test/run-tests.mjs"
  },
  "dependencies": {
    "@skiff/core": "workspace:*",
    "@skiff/shared": "workspace:*",
    "electron-updater": "^6.8.9",
    "ssh2": "^1.16.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/ssh2": "^1.15.1",
    "concurrently": "^9.2.1",
    "electron": "32.3.3",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0",
    "tsx": "^4.19.0"
  },
  "build": {
    "appId": "me.skiffssh.desktop",
    "productName": "Skiff",
    "electronVersion": "32.3.3",
    "copyright": "Copyright © Skiff Contributors. AGPL-3.0.",
    "directories": {
      "output": "release",
      "buildResources": "electron"
    },
    "files": [
      "dist/**/*",
      "!**/*.map"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Priyanshu-1622",
        "repo": "skiff-app"
      }
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/argon2/**",
      "**/node_modules/cpu-features/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Skiff-win-${arch}.${ext}",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Skiff",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "Skiff-mac-${arch}.${ext}",
      "icon": "electron/icon.png",
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "notarize": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "Skiff Contributors",
      "artifactName": "Skiff-linux-${arch}.${ext}",
      "icon": "electron/icon.png",
      "synopsis": "Self-hosted SSH access control and audit",
      "description": "Skiff manages SSH connections and adds approval-gated access, a tamper-evident audit log, and session recording. Runs entirely on your machine.",
      "desktop": {
        "Name": "Skiff",
        "Comment": "Self-hosted SSH access control and audit",
        "Categories": "Development;Utility;",
        "Keywords": "ssh;terminal;sftp;audit;",
        "StartupWMClass": "Skiff"
      }
    },
    "icon": "electron/icon.png"
  }
}
